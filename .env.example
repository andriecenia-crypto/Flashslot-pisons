# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET: server-side only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*
PORT=5000
FLASK_DEBUG=0

# Business owners must enter this code on the register page to get an admin account.
ADMIN_SIGNUP_CODE=choose-a-private-owner-invite-code

# ---- Quick-Fill rules ----
# Default discount applied to a Flash Slot when an appointment is cancelled
FLASH_DISCOUNT_PERCENT=30
# Flash Slots expire this many minutes before the appointment would have started
FLASH_LEAD_MINUTES=15
